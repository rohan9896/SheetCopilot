# Vision-LLM providers for SheetCopilot semantic extraction
#
# Auto order: GROQ → OPENROUTER → (error if none — LLM required)

# --- Primary: Groq (qwen/qwen3.6-27b vision) ---
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.6-27b

# --- Fallback: OpenRouter (set model to Gemini / Anthropic / etc.) ---
OPENROUTER_API_KEY=
# Examples:
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_SITE_URL=https://yoursite.example
# OPENROUTER_APP_NAME=SheetCopilot

# --- Optional direct providers (used only if GROQ/OPENROUTER unset) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
